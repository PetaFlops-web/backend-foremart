{
  "app": {
    "name": "your_app_name"
  },
  "web": {
    "prefork": false,
    "port": 8080,
    "cors": {
      "allow_origins": "http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
    }
  },
  "ml_service_url": "http://127.0.0.1:8000",
  "log": {
    "level": 6
  },
  "database": {
    "username": "your_db_user",
    "password": "your_db_password",
    "host": "localhost",
    "port": 3306,
    "name": "your_db_name",
    "pool": {
      "idle": 10,
      "max": 100,
      "lifetime": 300
    }
  },
  "jwt": {
    "secret": "your_jwt_secret_key"
  },
  "group": {
    "id": "your_group_id"
  }
}
